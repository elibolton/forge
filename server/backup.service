[Unit]
Description=Forge nightly database backup
After=pocketbase.service

[Service]
Type=oneshot
User=pocketbase
Group=pocketbase
EnvironmentFile=-/etc/forge/backup.env
ExecStart=/opt/pocketbase/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/forge /var/lib/pocketbase
